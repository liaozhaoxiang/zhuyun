# ===== 服务 =====
ZH_AN_HOST=127.0.0.1
ZH_AN_PORT=8011

# ===== 存储（默认 SQLite，零依赖）=====
ZH_AN_DB_BACKEND=sqlite
# ZH_AN_MYSQL_DSN=<user>:<password>@127.0.0.1:3306/<dbname>

# ===== 缓存（默认进程内 LRU）=====
# ZH_AN_REDIS_URL=redis://127.0.0.1:6379/0
ZH_AN_CACHE_TTL=1800

# ===== 向量库（默认 numpy；Docker 起 Milvus 后改这里）=====
# ZH_AN_MILVUS_URI=http://127.0.0.1:19530
ZH_AN_MILVUS_COLLECTION=zhuan_clauses

# ===== 模型 =====
ZH_AN_EMBED_MODEL=BAAI/bge-m3
ZH_AN_EMBED_FALLBACK=BAAI/bge-small-zh-v1.5
ZH_AN_EMBED_DEVICE=cpu
ZH_AN_RERANK_MODEL=BAAI/bge-reranker-large
ZH_AN_RERANK_FALLBACK=BAAI/bge-reranker-base
HF_ENDPOINT=https://hf-mirror.com

# ===== 生成（不配则走严格抽取式）=====
# ZH_AN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ZH_AN_LLM_API_KEY=sk-xxx
# ZH_AN_LLM_MODEL=qwen-plus

# ===== 检索参数 =====
ZH_AN_TOP_K_DENSE=20
ZH_AN_TOP_K_SPARSE=20
ZH_AN_RRF_K=60
ZH_AN_RERANK_TOP_N=8
ZH_AN_MIN_RELEVANCE=0.28
ZH_AN_MAX_PARENTS=4
